# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Logs and local databases
*.log
*.sqlite
*.db
*.db.backup
# SQLite WAL sidecars. These appear next to the database once journal_mode=WAL
# is active and are recreated on every run; committing them risks checking a
# stale copy back in, which silently discards recent writes on checkout.
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Quick Ingest uploads
media_uploads/

# Local knowledge files and generated release packages
storage/
releases/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
